NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://scormflow:scormflow@localhost:5432/scormflow?schema=public

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_ATTEMPT_TTL_SECONDS=3600

# How the runtime treats CMI writes that fail validation:
#   lenient (default) — accept + persist, surface as warnings (mirrors real LMSes)
#   strict            — reject + report as errors (for conformance testing content)
SCORM_VALIDATION_MODE=lenient

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

REDIS_URL=
