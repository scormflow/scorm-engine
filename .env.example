NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://scormflow:scormflow@localhost:5432/scormflow?schema=public

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_ATTEMPT_TTL_SECONDS=3600

# How the runtime treats CMI writes that fail validation:
#   lenient (default) — accept + persist, surface as warnings (mirrors real LMSes)
#   strict            — reject + report as errors (for conformance testing content)
SCORM_VALIDATION_MODE=lenient

# Built-in LRS (xAPI 1.0.3). The LRS stamps every statement with an `authority`
# agent whose account lives on this home page and is named for the tenant.
XAPI_AUTHORITY_HOMEPAGE=https://scormflow.dev/lrs
# When true, State API writes against an existing document must carry If-Match or
# If-None-Match (409 otherwise) — the spec's concurrency rule. Off by default so
# simple clients keep working; turn it on for conformance testing.
XAPI_REQUIRE_PRECONDITIONS=false

# Webhooks. Failed deliveries retry with exponential backoff (base × 2^n, capped
# at 6 h) until WEBHOOK_MAX_ATTEMPTS, then land in the dead-letter state.
# WEBHOOK_WORKER_INTERVAL_MS=0 disables the retry poller.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_WORKER_INTERVAL_MS=5000
# Allow endpoints on localhost / private networks (local development only).
WEBHOOK_ALLOW_PRIVATE_URLS=false

# Per-tenant rate limit: at most RATE_LIMIT_MAX authenticated requests per
# RATE_LIMIT_WINDOW_SECONDS for each tenant (all its API keys, attempt tokens and
# cmi5 sessions share one budget). Over-budget requests get 429 + Retry-After.
# Counted per engine instance. 0 turns limiting off.
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_SECONDS=60

# Completion certificates: a PDF is issued the first time an attempt is completed
# and not failed. CERTIFICATE_VERIFY_BASE_URL is your public verification page;
# when set, <base>/<serial> is printed on every certificate.
CERTIFICATES_ENABLED=true
CERTIFICATE_ISSUER=ScormFlow
CERTIFICATE_VERIFY_BASE_URL=
CERTIFICATE_ACCENT_COLOR=

# AI analytics with each tenant's own provider + key (OpenAI, Anthropic, Gemini,
# Mistral, Groq, Together, Azure OpenAI, AWS Bedrock, Ollama, OpenAI-compatible,
# custom HTTP). Tenants' keys are encrypted under
# AI_MASTER_KEY: 32 bytes as hex or base64, e.g. `openssl rand -hex 32`. Leave
# it empty to turn the /api/v1/ai routes off. Keep it safe — losing or changing
# it makes every stored provider key unreadable.
AI_MASTER_KEY=
# Allow provider URLs on localhost / private networks (needed for a local Ollama).
AI_ALLOW_PRIVATE_URLS=false
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1024

# Session replay. Timelines are rebuilt from the commit log; players may also
# send opt-in capture events (tab hidden, idle, navigation, pointer). Set
# REPLAY_CAPTURE_ENABLED=false to refuse those.
REPLAY_CAPTURE_ENABLED=true
REPLAY_MAX_EVENTS_PER_ATTEMPT=5000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# Optional namespace for every stored key, so several deployments can share one
# bucket/directory. Tenant files always live under tenants/<tenantId>/ beneath it.
STORAGE_PREFIX=

# STORAGE_DRIVER=s3 — AWS S3, Cloudflare R2, MinIO or any S3-compatible store.
#   AWS:   leave S3_ENDPOINT empty, set S3_REGION (e.g. eu-west-1)
#   R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
#   MinIO: S3_ENDPOINT=http://localhost:9000, S3_REGION=us-east-1, S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials.
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false

REDIS_URL=

# Event bus. `memory` keeps events inside one process. `redis` carries them over
# a Redis stream (Redis 6.2+, REDIS_URL required): run it when several engine
# instances share one database, so each webhook is sent once and every
# instance's live event stream (GET /api/v1/events/stream) sees every event.
EVENT_BUS_DRIVER=memory
EVENT_BUS_STREAM=scormflow:events
EVENT_BUS_GROUP=scormflow
EVENT_BUS_MAX_LENGTH=100000
EVENT_STREAM_HEARTBEAT_SECONDS=15

# Built-in plugins, comma-separated. `analytics` adds live per-minute event
# counts at GET /api/v1/plugins/analytics/activity. Ignored when code passes
# its own `plugins` list to buildApp.
PLUGINS=
